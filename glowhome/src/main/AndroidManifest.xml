<?xml version="1.0" encoding="utf-8"?>
<!-- Glow Home: a minimal Android TV launcher, companion to TellyCat. Looping video background + one row of app
     banners. No internet. Its only permission lets it tell TellyCat where the selected tile is. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- defined by TellyCat (signature level: both apps must be signed with the same key) -->
    <uses-permission android:name="com.nikhil.glowcat.permission.HOME_EVENTS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Android 11+ package visibility: only apps that show up on a TV home screen -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:hardwareAccelerated="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|fontScale|density"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
